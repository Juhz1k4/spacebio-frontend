# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Variaveis de ambiente e segredos (SEGURANCA)
# O .env chegou a ser versionado. O que havia nele eram as chaves publicas do
# Supabase (project id, anon key, URL) - publicas por design, nenhuma senha foi
# exposta. Ainda assim o arquivo nao pertence ao versionamento: e onde os
# segredos locais sao colocados. Use .env.example como modelo.
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem

# ---------------------------------------------------------------------------
# E3-08 -- segredos que o .gitignore anterior nao cobria
# ---------------------------------------------------------------------------
# Auditado com `git check-ignore` sobre caminhos reais, e nao por leitura do
# arquivo: um padrao pode parecer certo e nao casar. Os oito abaixo passavam.
#
# Cada linha existe porque a ferramenta correspondente grava o arquivo NO
# DIRETORIO DO PROJETO por padrao -- e e assim que segredo vaza: nao por
# descuido, mas porque o arquivo aparece onde ninguem esperava.

# Chaves SSH (ssh-keygen sugere o diretorio atual se o -f for relativo)
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
.ssh/

# Certificados e chaves TLS (*.pem ja coberto acima)
*.key
*.p12
*.pfx
*.crt
*.cer

# Credenciais de servico em JSON/YAML
credentials.json
credentials.yml
credentials.yaml
service-account*.json
gcp-*.json
*-service-account.json
secrets.yml
secrets.yaml

# Tokens de registro de pacote (npm login grava o token aqui)
.npmrc
.yarnrc
.pypirc

# Dumps e backups, que costumam carregar dados reais
*.sql
*.dump
*.bak
